+// Jawaban semua peserta aktif sudah masuk untuk soal i
+function mpCurrentPicks(i) {
+  const all = (mpRoom.answers && mpRoom.answers[i]) || {};
+  const out = {};
+  Object.keys(mpRoom.players || {}).forEach((u) => { if (all[u] !== undefined) out[u] = all[u]; });
